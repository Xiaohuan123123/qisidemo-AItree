# DeepSeek API Key（必填）：对话、分析、生成、卡片提取
DEEPSEEK_API_KEY=

# 多模态截图识别（可选）：OpenAI 兼容接口
# 智谱 GLM（默认）：https://openai.zhipuai.cn/api/paas/v4 + glm-4v-flash（免费档）
# 通义 Qwen-VL：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-vl-max
# 豆包：https://ark.cn-beijing.volces.com/api/v3 + doubao-1.5-vision-pro-32k
VISION_API_KEY=
VISION_BASE_URL=https://openai.zhipuai.cn/api/paas/v4
VISION_MODEL=glm-4v-flash

# 飞书云文档同步（可选）：自建应用的用户身份 OAuth
# 创建步骤见 README「同步到飞书」章节
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3001/api/feishu-callback
# token 存储方式：留空自动探测（本地 file / Vercel 自动降级 memory）
# FEISHU_TOKEN_STORE=file
